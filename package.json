{
  "name": "promptcard-agent",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "dev:with-agent": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-with-agent.ps1",
    "desktop:dev-services": "powershell -ExecutionPolicy Bypass -File scripts/start-desktop-dev-services.ps1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "storage:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-storage-service.ps1",
    "storage:test": "python -m unittest discover -s promptcard_storage/tests -p \"test_*.py\"",
    "agent:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-agent-runtime.ps1",
    "agent:check": "powershell -ExecutionPolicy Bypass -File scripts/check-agent-runtime.ps1",
    "text-agent:dev": "node --experimental-strip-types text-agent-runtime/src/server.ts",
    "text-agent:check": "tsc -p text-agent-runtime/tsconfig.json",
    "startup:test": "powershell -ExecutionPolicy Bypass -File scripts/test-start-from-bat.ps1",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 30",
    "preview": "vite preview",
    "pretest": "npm run test:contracts",
    "test": "vitest",
    "test:contracts": "node --test --test-isolation=none tests/contracts/promptcard-bridge-contract.test.mjs",
    "bridge:cli": "node --experimental-strip-types promptcard-bridge-cli/src/cli.ts",
    "bridge:cli:check": "tsc -p promptcard-bridge-cli/tsconfig.json",
    "test:bridge-cli": "node --experimental-strip-types --test promptcard-bridge-cli/tests/*.test.ts",
    "mcp:stdio": "node --experimental-strip-types promptcard-mcp/src/stdio.ts",
    "mcp:http": "node --experimental-strip-types promptcard-mcp/src/http-entry.ts",
    "mcp:check": "tsc -p promptcard-mcp/tsconfig.json",
    "test:mcp": "node --experimental-strip-types --test promptcard-mcp/tests/*.test.ts",
    "test:frontend": "powershell -ExecutionPolicy Bypass -File scripts/run-frontend-tests.ps1",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-tests.ps1",
    "test:e2e:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-tests.ps1 --real-gateway tests/e2e/bridge-document-delivery.spec.ts --workers=1",
    "test:e2e:real-codex-discovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-tests.ps1 --real-codex tests/e2e/real-codex-discovery.spec.ts --workers=1",
    "test:e2e:bridge-restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-bridge-restart-e2e.ps1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.8",
    "@earendil-works/pi-ai": "^0.80.8",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tauri-apps/api": "^2.11.0",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-link": "3.30.3",
    "@tiptap/extension-list": "3.30.3",
    "@tiptap/extension-table": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.6.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.40.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-test-renderer": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "8.17.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.30.3",
    "@tiptap/extension-floating-menu": "3.30.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
