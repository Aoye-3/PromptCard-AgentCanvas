{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/schema.json",
  "title": "PromptCard Bridge v1 contract resources",
  "$defs": {
    "ProjectCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code.schema.json",
      "type": "string",
      "pattern": "^PRJ-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PromptBundleCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code.schema.json",
      "type": "string",
      "pattern": "^PLP-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PromptMediaCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code.schema.json",
      "type": "string",
      "pattern": "^PLM-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CanvasTemplateCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code.schema.json",
      "type": "string",
      "pattern": "^CVT-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CanvasMediaCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code.schema.json",
      "type": "string",
      "pattern": "^CVM-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CanvasCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code.schema.json",
      "type": "string",
      "pattern": "^CVC-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SkillCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json",
      "type": "string",
      "pattern": "^SKL-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ProjectCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code-input.schema.json",
      "type": "string",
      "pattern": "^[Pp][Rr][Jj]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "PromptBundleCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code-input.schema.json",
      "type": "string",
      "pattern": "^[Pp][Ll][Pp]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "PromptMediaCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code-input.schema.json",
      "type": "string",
      "pattern": "^[Pp][Ll][Mm]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "CanvasTemplateCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code-input.schema.json",
      "type": "string",
      "pattern": "^[Cc][Vv][Tt]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "CanvasMediaCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code-input.schema.json",
      "type": "string",
      "pattern": "^[Cc][Vv][Mm]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "CanvasCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code-input.schema.json",
      "type": "string",
      "pattern": "^[Cc][Vv][Cc]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "SkillCodeInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code-input.schema.json",
      "type": "string",
      "pattern": "^[Ss][Kk][Ll]-[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"
    },
    "CanonicalReferenceCode": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json",
      "oneOf": [
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json"
        }
      ]
    },
    "ExactReferenceInput": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/exact-reference-input.schema.json",
      "title": "Exact typed public reference input",
      "description": "An exact execution target. Discovery result objects and internal storage identifiers are not valid inputs.",
      "oneOf": [
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code-input.schema.json"
        },
        {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code-input.schema.json"
        }
      ]
    },
    "TypedReference": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/typed-reference.schema.json",
      "title": "Typed public reference",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "project" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "promptBundle" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "promptMedia" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "canvasTemplate" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "canvasMedia" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "canvas" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "skill" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json"
            }
          },
          "required": ["namespace", "code"],
          "additionalProperties": false
        }
      ]
    },
    "Digest": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ClientRequestId": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/client-request-id.schema.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "SourceCodeLists": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/source-code-lists.schema.json",
      "type": "object",
      "properties": {
        "promptBundleCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code-input.schema.json"
          },
          "uniqueItems": true
        },
        "promptMediaCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code-input.schema.json"
          },
          "uniqueItems": true
        },
        "canvasTemplateCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-template-code-input.schema.json"
          },
          "uniqueItems": true
        },
        "canvasMediaCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code-input.schema.json"
          },
          "uniqueItems": true
        },
        "skillCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code-input.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "promptBundleCodes",
        "promptMediaCodes",
        "canvasTemplateCodes",
        "canvasMediaCodes",
        "skillCodes"
      ],
      "additionalProperties": false
    },
    "SearchResult": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/search-result.schema.json",
      "title": "Discovery-only search result",
      "description": "Search results support discovery and must be resolved to an exact code string before execution.",
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/typed-reference.schema.json"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "score": { "type": "number" },
        "sourceCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": ["reference", "title", "summary", "score", "sourceCodes"],
      "additionalProperties": false
    },
    "PromptBundle": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle.schema.json",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-bundle-code.schema.json"
        },
        "revisionDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "mediaCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code.schema.json"
          },
          "uniqueItems": true
        },
        "sourceCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "revisionDigest",
        "title",
        "prompt",
        "mediaCodes",
        "sourceCodes"
      ],
      "additionalProperties": false
    },
    "MediaResource": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/media-resource.schema.json",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "promptMedia" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/prompt-media-code.schema.json"
            },
            "mediaType": { "type": "string", "minLength": 1 },
            "contentDigest": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
            },
            "byteLength": { "type": "integer", "minimum": 0 }
          },
          "required": [
            "namespace",
            "code",
            "mediaType",
            "contentDigest",
            "byteLength"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "namespace": { "const": "canvasMedia" },
            "code": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-media-code.schema.json"
            },
            "mediaType": { "type": "string", "minLength": 1 },
            "contentDigest": {
              "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
            },
            "byteLength": { "type": "integer", "minimum": 0 }
          },
          "required": [
            "namespace",
            "code",
            "mediaType",
            "contentDigest",
            "byteLength"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ContextEntry": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/context-entry.schema.json",
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/typed-reference.schema.json"
        },
        "content": { "type": "string" },
        "contentDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        }
      },
      "required": ["reference", "content", "contentDigest"],
      "additionalProperties": false
    },
    "ContextPack": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/context-pack.schema.json",
      "type": "object",
      "properties": {
        "projectCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/project-code.schema.json"
        },
        "cvcCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code.schema.json"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/context-entry.schema.json"
          }
        },
        "sourceCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": ["projectCode", "cvcCode", "entries", "sourceCodes"],
      "additionalProperties": false
    },
    "SkillPackage": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-package.schema.json",
      "type": "object",
      "properties": {
        "skillCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "currentRevisionDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "sourceCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "skillCode",
        "name",
        "description",
        "currentRevisionDigest",
        "sourceCodes"
      ],
      "additionalProperties": false
    },
    "SkillRevision": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-revision.schema.json",
      "type": "object",
      "properties": {
        "skillCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json"
        },
        "revisionDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            },
            "required": ["path", "content"],
            "additionalProperties": false
          }
        },
        "sourceCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": ["skillCode", "revisionDigest", "files", "sourceCodes"],
      "additionalProperties": false
    },
    "SkillHostPin": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-host-pin.schema.json",
      "type": "object",
      "properties": {
        "host": { "enum": ["local-agent", "codex"] },
        "skillCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/skill-code.schema.json"
        },
        "revisionDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        }
      },
      "required": ["host", "skillCode", "revisionDigest"],
      "additionalProperties": false
    },
    "AdditiveKind": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-kind.schema.json",
      "enum": ["canvas.media.add", "canvas.node.add", "skill.projection.add"]
    },
    "AdditiveItem": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-item.schema.json",
      "type": "object",
      "properties": {
        "clientItemId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contentDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "label": { "type": "string" }
      },
      "required": ["clientItemId", "contentDigest", "label"],
      "additionalProperties": false
    },
    "Proposal": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/proposal.schema.json",
      "title": "Non-mutating additive delivery proposal",
      "type": "object",
      "properties": {
        "clientRequestId": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/client-request-id.schema.json"
        },
        "normalizedRequestDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "cvcCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code-input.schema.json"
        },
        "kind": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-kind.schema.json"
        },
        "sourceCodeLists": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/source-code-lists.schema.json"
        },
        "summary": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-item.schema.json"
          }
        }
      },
      "required": [
        "clientRequestId",
        "normalizedRequestDigest",
        "cvcCode",
        "kind",
        "sourceCodeLists",
        "summary",
        "items"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/delivery.schema.json",
      "title": "Additive-only Codex delivery request",
      "type": "object",
      "properties": {
        "clientRequestId": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/client-request-id.schema.json"
        },
        "normalizedRequestDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "cvcCode": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canvas-code-input.schema.json"
        },
        "kind": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-kind.schema.json"
        },
        "sourceCodeLists": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/source-code-lists.schema.json"
        },
        "provenance": { "const": "codex-harness" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/additive-item.schema.json"
          }
        }
      },
      "required": [
        "clientRequestId",
        "normalizedRequestDigest",
        "cvcCode",
        "kind",
        "sourceCodeLists",
        "provenance",
        "items"
      ],
      "additionalProperties": false
    },
    "Status": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/status.schema.json",
      "type": "object",
      "properties": {
        "clientRequestId": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/client-request-id.schema.json"
        },
        "normalizedRequestDigest": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/digest.schema.json"
        },
        "state": {
          "enum": ["accepted", "pending", "applied", "rejected", "failed"]
        },
        "message": { "type": "string" },
        "resultCodes": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/canonical-reference-code.schema.json"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "clientRequestId",
        "normalizedRequestDigest",
        "state",
        "message",
        "resultCodes"
      ],
      "additionalProperties": false
    },
    "StructuredError": {
      "$id": "https://schemas.promptcard.dev/promptcard-bridge/v1/structured-error.schema.json",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "clientRequestId": {
          "$ref": "https://schemas.promptcard.dev/promptcard-bridge/v1/client-request-id.schema.json"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["path", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["code", "message", "retryable", "details"],
      "additionalProperties": false
    }
  }
}
